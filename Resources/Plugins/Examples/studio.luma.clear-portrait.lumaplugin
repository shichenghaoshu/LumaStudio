{
  "schemaVersion": 1,
  "manifest": {
    "id": "studio.luma.clear-portrait",
    "version": "1.0.0",
    "name": "通透人像配方",
    "summary": "调整影调、肤质与色彩。只同步声明的分组，保留目标照片构图和局部蒙版。",
    "author": {
      "id": "lumastudio",
      "name": "LumaStudio 示例作者",
      "roles": [
        "photographer",
        "colorist",
        "developer"
      ]
    },
    "kind": "recipe",
    "license": {
      "type": "openSource",
      "spdx": "MIT",
      "sourceURL": "https://github.com/shichenghaoshu/LumaStudio/tree/main/Resources/Plugins/Examples",
      "terms": "MIT License. Copyright (c) 2026 LumaStudio contributors. Permission is granted to use, copy, modify, merge, publish, distribute, sublicense and sell copies, subject to retaining the copyright and permission notice. Provided AS IS, without warranty. Full license: Resources/Plugins/LICENSE.txt."
    },
    "tags": [
      "人像",
      "通透",
      "示例"
    ],
    "capabilities": [
      "edit.recipe"
    ],
    "supports": [
      "editor",
      "batch",
      "agent"
    ]
  },
  "payload": {
    "groups": [
      "tone",
      "color",
      "beauty"
    ],
    "recipe": {
      "version": 2,
      "global": {
        "exposure": 0.18,
        "contrast": 1.06,
        "highlights": -0.15,
        "shadows": 0.1,
        "saturation": 0.96
      },
      "beauty": {
        "enabled": true,
        "strength": 0.65,
        "texturePreservation": 0.72
      },
      "color": {
        "enabled": true
      }
    }
  },
  "assets": []
}
