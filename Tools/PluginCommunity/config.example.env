# Never put credentials in this file.
LUMA_COMMUNITY_PORT=8791
# Local mode defaults to loopback and the per-user Application Support directory.
# LUMA_COMMUNITY_DATA=/absolute/path/community.sqlite3
# Docker public mode: bind inside the container, expose host port on loopback only.
# LUMA_COMMUNITY_BIND=0.0.0.0
# LUMA_COMMUNITY_PUBLIC_ORIGIN=https://community.example.com
